{
  // Cloudflare config: serves the static website in ./public
  "name": "exotic-earthworks",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Connects the site to the root domain. www is redirected to it by a Cloudflare Redirect Rule.
  "routes": [
    { "pattern": "exoticearthworks.com.au", "custom_domain": true }
  ]
}
