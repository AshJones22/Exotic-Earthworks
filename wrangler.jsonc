{
  // Cloudflare config for exoticearthworks.com.au
  "name": "exotic-earthworks",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Booking and quote emails go to the verified business inbox only.
  "send_email": [
    { "name": "OWNER_EMAIL", "destination_address": "ashveer.sewlal@gmail.com" }
  ],
  // Root domain serves the site; www (any protocol) is caught by the Worker and redirected to https://exoticearthworks.com.au
  "routes": [
    { "pattern": "exoticearthworks.com.au", "custom_domain": true },
    { "pattern": "www.exoticearthworks.com.au/*", "zone_name": "exoticearthworks.com.au" }
  ]
}
